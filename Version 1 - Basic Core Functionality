import java.io.*;
import java.util.*;

public class TARecruitmentV1 {
    private static final String FILE_NAME = "applicants.csv";

    public static void main(String[] args) {
        System.out.println("--- BUPT TA System V1 ---");
        // Core Function: Simulate saving applicant data
        saveToCSV("Li Haoyang", "Java, Python");
        System.out.println("Data saved to " + FILE_NAME); // Complies with no-database requirement
    }

    public static void saveToCSV(String name, String skills) {
        try (PrintWriter out = new PrintWriter(new FileWriter(FILE_NAME, true))) {
            out.println(name + "," + skills);
        } catch (IOException e) { e.printStackTrace(); }
    }
}
